#!/usr/bin/env bash
# Set up this rice from ~/dotfiles (made for CachyOS + Hyprland, works on Arch
# with paru). Safe to run again.
#
#   git clone https://github.com/AdiP1353/dotfiles ~/dotfiles
#   ~/dotfiles/install --packages     # install packages first (asks), then set up
#   ~/dotfiles/install                # set up only
#   ~/dotfiles/install --links-only   # just link the files (for testing)
#
# Setting up = link every file here into your home folder (anything already
# there is kept as <name>.bak-rice), then `rice install`: the automatic
# re-apply units and a full theme check. Afterwards, once, with sudo:
#   sudo ~/.config/rice-greeter/install.sh     login and lock screen
#   sudo ~/.config/rice/system/install.sh      pacman hook, Firefox new tab, greeter sync
# then log in to Hyprland and pick a wallpaper (SUPER + W): every colour
# comes from it.
set -euo pipefail
D="$(cd "$(dirname "$0")" && pwd)"
packages=0; links_only=0
for a in "$@"; do
    case "$a" in
        --packages) packages=1 ;;
        --links-only) links_only=1 ;;
        -h|--help) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "unknown option: $a" >&2; exit 2 ;;
    esac
done

list() { sed 's/#.*//' "$D/packages/$1" | tr -s ' \t' '\n' | grep -v '^$' || true; }

if [ "$packages" = 1 ]; then
    # pacman refuses the whole list if one name is unknown, so anything the
    # enabled repositories don't have (plain Arch: paru, cachy-update...) goes
    # to paru with the AUR list instead.
    repo=(); aur=()
    for p in $(list repo.txt); do
        if pacman -Si "$p" >/dev/null 2>&1; then repo+=("$p"); else aur+=("$p"); fi
    done
    for p in $(list aur.txt); do aur+=("$p"); done
    echo "packages from the repositories:"; echo "${repo[*]:-}"; echo
    echo "packages from the AUR (paru):"; echo "${aur[*]:-}"; echo
    read -r -p "install them? [y/N] " ok
    if [ "${ok,,}" = y ]; then
        [ ${#repo[@]} -eq 0 ] || sudo pacman -S --needed "${repo[@]}"
        if [ ${#aur[@]} -gt 0 ]; then
            if command -v paru >/dev/null; then paru -S --needed "${aur[@]}"
            else echo "paru isn't installed (https://github.com/Morganamilo/paru): install these yourself: ${aur[*]}"; fi
        fi
    fi
fi

# shellcheck source=.config/rice/lib/links.sh
. "$D/.config/rice/lib/links.sh"
n=0; skipped=()
while IFS= read -r -d '' line; do
    mode=${line%% *}; path=${line#*$'\t'}
    dots_skip "$path" && continue
    dst="$HOME/$path"
    if via=$(dots_parent_link "$path"); then skipped+=("$path (${via/#$HOME/\~} is a link)"); continue; fi
    mkdir -p "$(dirname "$dst")"
    if [ "$mode" = 120000 ]; then [ -L "$dst" ] || cp -P "$D/$path" "$dst"; continue; fi
    [ "$(readlink "$dst" 2>/dev/null)" = "$D/$path" ] && continue
    if [ -e "$dst" ] || [ -L "$dst" ]; then
        # never overwrite an older backup: the first one is your original
        bak="$dst.bak-rice"
        if [ -e "$bak" ] || [ -L "$bak" ]; then bak="$dst.bak-rice-$(date +%Y%m%d-%H%M%S)-$$"; fi
        mv "$dst" "$bak"; echo "kept your old ~/$path as ${bak/#$HOME/\~}"
    fi
    ln -s "$D/$path" "$dst"; n=$((n+1))
done < <(git -C "$D" ls-files -s -z)
echo "linked $n files from $D into $HOME"
if [ ${#skipped[@]} -gt 0 ]; then
    echo "not linked: these go through a folder that is a link to somewhere else"
    echo "(another dotfiles setup?). Replace that link with a real folder and run again:"
    printf '  %s\n' "${skipped[@]}"
fi
[ "$links_only" = 1 ] && exit 0

"$HOME/.config/rice/bin/rice" install || true
cat <<EOF

next, once:
  sudo ~/.config/rice-greeter/install.sh
  sudo ~/.config/rice/system/install.sh
then log in to Hyprland and pick a wallpaper with SUPER + W.
EOF
