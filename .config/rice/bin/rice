#!/usr/bin/env bash
# rice: keeps the whole desktop theme in place (see ~/.config/rice/THEME.md).
#
#   rice check            show what is themed and what is not
#   rice apply [part...]  put the theme back wherever it is missing (safe to
#                         run any time; only changes what is off)
#   rice install          first-time setup on a new machine: links, the
#                         automatic re-apply units, then `rice apply`
#
# Parts: colors gtk desktop firefox web obsidian spotify discord editor terminal
#        launcher greeter qt video cursor
#
# Runs by itself: at login and every 6 hours (rice-apply.timer), right after
# a Spotify update (rice-spotify.path), and after pacman updates the themed
# apps (the pacman hook from `sudo ~/.config/rice/system/install.sh`).

set -uo pipefail

RICE="$HOME/.config/rice"
# Shared link rules with ~/dotfiles/install: the copy next to this script in
# the repo (so it's there even before the links are refreshed).
_lib="$(dirname "$(readlink -f "$0")")/../lib/links.sh"
[ -f "$_lib" ] || _lib="$RICE/lib/links.sh"
# shellcheck source=../lib/links.sh
. "$_lib" || { echo "rice: $_lib is missing (git -C ~/dotfiles pull?)" >&2; exit 2; }
QUIET=0
FIXED=0
BROKEN=0

say()  { [ "$QUIET" = 1 ] || printf '%s\n' "$*"; }
ok()   { say "  ok      $*"; }
fixed(){ say "  fixed   $*"; FIXED=$((FIXED + 1)); }
warn() { printf '  needs   %s\n' "$*" >&2; BROKEN=$((BROKEN + 1)); }
running() { pgrep -x "$1" >/dev/null 2>&1; }
MODE=check   # or apply

# ---------------------------------------------------------------- colours
part_colors() {
    say "colours (noctalia templates)"
    if ! command -v noctalia >/dev/null; then warn "noctalia is not installed"; return; fi
    if [ "$MODE" = apply ]; then
        if noctalia msg templates-apply >/dev/null 2>&1; then fixed "re-rendered every template from the wallpaper"
        else warn "noctalia is not running; colours re-render when it starts"; fi
    else
        for f in "$HOME/.local/state/rice/colors.json" "$RICE/firefox/rice-colors.css" \
                                  "$HOME/.config/spicetify/Themes/Rice/color.ini" \
                 "$HOME/.config/vesktop/themes/noctalia.theme.css" \
                 "$HOME/.local/state/rice/viz.json"; do
            [ -s "$f" ] && ok "${f/#$HOME/\~}" || warn "${f/#$HOME/\~} missing (rice apply colors)"
        done
    fi
}

# ---------------------------------------------------------------- GTK / Qt
gset() { # schema key value
    local cur; cur=$(gsettings get "$1" "$2" 2>/dev/null)
    if [ "$cur" = "'$3'" ]; then ok "$2 = $3"
    elif [ "$MODE" = apply ]; then gsettings set "$1" "$2" "$3" && fixed "$2 = $3"
    else warn "$2 is $cur, should be '$3'"; fi
}
part_gtk() {
    say "gtk / qt"
    gset org.gnome.desktop.interface color-scheme prefer-dark
    gset org.gnome.desktop.interface gtk-theme adw-gtk3-dark
    gset org.gnome.desktop.interface icon-theme breeze-dark
    gset org.gnome.desktop.interface font-name "JetBrainsMono Nerd Font 10"
    gset org.gnome.desktop.interface monospace-font-name "JetBrainsMono Nerd Font 10"
    grep -q '^icon_theme=breeze-dark' "$HOME/.config/qt6ct/qt6ct.conf" 2>/dev/null && ok "qt6ct icons" || warn "qt6ct icon_theme is not breeze-dark"
    for v in 3.0 4.0; do
        grep -q 'border-radius: 0' "$HOME/.config/gtk-$v/gtk.css" 2>/dev/null && ok "gtk-$v square corners" || warn "gtk-$v/gtk.css lost its square corners"
    done
}

# ---------------------------------------------------------------- Firefox
ff_profile() {
    local base="$HOME/.config/mozilla/firefox" rel
    [ -d "$base" ] || base="$HOME/.mozilla/firefox"
    rel=$(sed -n 's/^Default=//p' "$base/installs.ini" 2>/dev/null | head -n1)
    [ -n "$rel" ] || rel=$(awk -F= '/^Path=/{p=$2} /^Default=1/{print p; exit}' "$base/profiles.ini" 2>/dev/null)
    [ -n "$rel" ] && [ -d "$base/$rel" ] && printf '%s' "$base/$rel"
}
# Edit the profile's add-on list with a jq filter (Firefox must be closed).
# Written to a temp file first: a failed edit never leaves it half written.
ff_addons() { # profile filter
    local f="$1/extensions.json"
    jq "$2" "$f" > "$f.rice-tmp" 2>/dev/null && [ -s "$f.rice-tmp" ] || { rm -f "$f.rice-tmp"; return 1; }
    cp -p "$f" "$f.bak-rice" && mv "$f.rice-tmp" "$f" && rm -f "$1/addonStartup.json.lz4"
}
link_to() { # link target name
    local link="$1" target="$2"
    if [ "$(readlink "$link" 2>/dev/null)" = "$target" ]; then ok "${link/#$HOME/\~}"
    elif [ "$MODE" = apply ]; then
        [ -e "$link" ] && [ ! -L "$link" ] && mv "$link" "$link.bak-rice-$(date +%s)"
        ln -sfn "$target" "$link" && fixed "${link/#$HOME/\~} -> ${target/#$HOME/\~}"
    else warn "${link/#$HOME/\~} is not linked to ${target/#$HOME/\~}"; fi
}
part_firefox() {
    say "firefox"
    command -v firefox >/dev/null || { say "  skip    firefox is not installed"; return; }
    local p; p=$(ff_profile) || true
    [ -n "$p" ] || { warn "no Firefox profile yet (start Firefox once)"; return; }
    link_to "$p/chrome" "$RICE/firefox"
    link_to "$p/user.js" "$RICE/firefox/user.js"
    # The add-on list decides the active theme; it must be the default one
    # (an add-on theme paints over userChrome). Only edited while Firefox is closed.
    local active
    active=$(jq -r '[.addons[] | select(.type=="theme" and .active) | .id] | join(",")' "$p/extensions.json" 2>/dev/null) \
        || { [ ! -f "$p/extensions.json" ] || active="unknown (extensions.json is unreadable)"; }
    if [ "$active" = "default-theme@mozilla.org" ] || [ -z "$active" ]; then ok "default theme active"
    elif [ "$MODE" = apply ] && ! running firefox; then
        ff_addons "$p" '(.addons[] | select(.type=="theme")) |= (.active = (.id == "default-theme@mozilla.org") | .userDisabled = (.id != "default-theme@mozilla.org"))' \
            && fixed "switched Firefox back to the default theme" || warn "could not edit Firefox's add-on list ($p/extensions.json)"
    else warn "an add-on theme is active ($active); close Firefox and run: rice apply firefox"; fi
}

# ---------------------------------------------------------------- Obsidian
part_obsidian() {
    say "obsidian"
    local cfg="$HOME/.config/obsidian/obsidian.json"
    [ -f "$cfg" ] || { say "  skip    obsidian has no vaults yet"; return; }
    if [ "$(jq -r '.frame // ""' "$cfg")" = hidden ]; then ok "window frame hidden"
    elif [ "$MODE" = apply ] && ! running obsidian; then
        jq '.frame = "hidden"' "$cfg" > "$cfg.tmp" && mv "$cfg.tmp" "$cfg" && fixed "window frame hidden"
    else warn "Obsidian draws its own window buttons (close Obsidian, rice apply obsidian)"; fi
    while IFS= read -r v; do
        [ -d "$v/.obsidian" ] || continue
        local snip="$v/.obsidian/snippets/rice.css" app="$v/.obsidian/appearance.json"
        if cmp -s "$RICE/obsidian/rice.css" "$snip"; then ok "${v##*/}: rice.css"
        elif [ "$MODE" = apply ]; then mkdir -p "${snip%/*}"; cp "$RICE/obsidian/rice.css" "$snip" && fixed "${v##*/}: rice.css"
        else warn "${v##*/}: rice.css missing or old"; fi
        [ -f "$app" ] || [ "$MODE" != apply ] || echo '{}' > "$app"
        if jq -e '.theme == "obsidian" and ((.enabledCssSnippets // []) | index("rice")) and ((.enabledCssSnippets // []) | index("noctalia"))' "$app" >/dev/null 2>&1; then
            ok "${v##*/}: snippets on"
        elif [ "$MODE" = apply ]; then
            jq '.theme = "obsidian" | .enabledCssSnippets = (((.enabledCssSnippets // []) + ["noctalia", "rice"]) | unique)' "$app" > "$app.tmp" \
                && mv "$app.tmp" "$app" && fixed "${v##*/}: snippets on"
        else warn "${v##*/}: snippets not enabled"; fi
    done < <(jq -r '.vaults[]?.path' "$cfg")
}

# ---------------------------------------------------------------- Spotify
part_spotify() {
    say "spotify"
    command -v spicetify >/dev/null || { say "  skip    spicetify is not installed"; return; }
    local apps
    apps="$(sed -n 's/^spotify_path *= *//p' "$HOME/.config/spicetify/config-xpui.ini" 2>/dev/null | head -n1)"
    apps="${apps/\$HOME/$HOME}"; apps="${apps%/}/Apps"
    [ -d "$apps" ] || { warn "Spotify is not installed where Spicetify looks ($apps)"; return; }
    local cfg="$HOME/.config/spicetify/config-xpui.ini"
    grep -q '^current_theme *= *Rice' "$cfg" && ok "theme Rice" || { [ "$MODE" = apply ] && spicetify -q config current_theme Rice color_scheme rice replace_colors 1 >/dev/null && fixed "theme Rice" || warn "Spicetify theme is not Rice"; }
    if [ ! -e "$apps/xpui.spa" ]; then ok "Spotify is patched"; spotify_watcher; return; fi
    # xpui.spa back = Spotify updated (or was never patched).
    if [ "$MODE" = apply ]; then
        # spotify-launcher may still be unpacking the update: wait for it
        for _ in $(seq 30); do running spotify-launcher || break; sleep 2; done
        if yes | spicetify -q backup apply >/dev/null 2>&1 || yes | spicetify -q restore backup apply >/dev/null 2>&1; then
            fixed "re-patched Spotify after an update"; spotify_watcher
        else warn "Spicetify could not patch Spotify; run: spicetify restore backup apply"; fi
    else warn "Spotify was updated and lost its theme (rice apply spotify)"; fi
}

# rice-spotify.path stops watching after repeated failed patches (its service's
# start limit). Once Spotify is patched again it is safe to restart it.
spotify_watcher() {
    systemctl --user is-failed --quiet rice-spotify.path 2>/dev/null || return 0
    if [ "$MODE" = apply ]; then
        systemctl --user reset-failed rice-spotify.path rice-spotify.service 2>/dev/null
        systemctl --user start rice-spotify.path 2>/dev/null && fixed "Spotify update watcher restarted" || warn "could not restart rice-spotify.path"
    else warn "the Spotify update watcher gave up after failed patches (rice apply spotify)"; fi
}

# ---------------------------------------------------------------- Discord (Vesktop)
part_discord() {
    say "discord (vesktop)"
    command -v vesktop >/dev/null || { say "  skip    vesktop is not installed"; return; }
    local s="$HOME/.config/vesktop/settings/settings.json"
    [ -s "$HOME/.config/vesktop/themes/rice.theme.css" ] && ok "rice.theme.css" || warn "vesktop/themes/rice.theme.css missing"
    [ "$MODE" != apply ] || { mkdir -p "${s%/*}"; [ -f "$s" ] || echo '{}' > "$s"; }
    if jq -e '(.enabledThemes // []) | (index("noctalia.theme.css") != null and index("rice.theme.css") != null)' "$s" >/dev/null 2>&1; then
        ok "themes enabled"
    elif [ "$MODE" = apply ]; then
        jq '.enabledThemes = (((.enabledThemes // []) - ["noctalia.theme.css", "rice.theme.css"]) + ["noctalia.theme.css", "rice.theme.css"])' "$s" > "$s.tmp" \
            && mv "$s.tmp" "$s" && fixed "themes enabled (restart Vesktop)"
    else warn "Vesktop themes are not enabled"; fi
}

# ---------------------------------------------------------------- editors
part_editor() {
    say "editors (fixed code colours, never the wallpaper)"
    [ -f "$HOME/.local/share/gtksourceview-5/styles/rice-code.xml" ] && ok "text editor scheme rice-code" || {
        [ "$MODE" = apply ] && mkdir -p "$HOME/.local/share/gtksourceview-5/styles" && cp "$RICE/editors/rice-code.xml" "$HOME/.local/share/gtksourceview-5/styles/" && fixed "rice-code scheme installed" || warn "rice-code scheme missing"; }
    gset org.gnome.TextEditor style-scheme rice-code
    local z="$HOME/.config/zed/settings.json"
    if [ -f "$z" ]; then
        grep -q '"dark": "One Dark"' "$z" && grep -q '"ui_font_family": "JetBrainsMono Nerd Font"' "$z" \
            && ok "zed: One Dark, JetBrains Mono" || warn "zed settings lost its fixed theme or font (THEME.md §5)"
    fi
}

# ---------------------------------------------------------------- launcher entries
part_launcher() {
    say "launcher"
    local d="$HOME/.local/share/applications/vesktop.desktop"
    if command -v vesktop >/dev/null; then
        grep -q '^Name=Discord$' "$d" 2>/dev/null && ok "Vesktop shows as Discord" || {
            if [ "$MODE" = apply ] && [ -f /usr/share/applications/vesktop.desktop ]; then
                sed -e 's/^Name=Vesktop$/Name=Discord/' -e 's/^Icon=vesktop$/Icon=discord/' /usr/share/applications/vesktop.desktop > "$d" && fixed "Vesktop shows as Discord"
            else warn "Vesktop is not renamed to Discord"; fi; }
        [ -f "$HOME/.local/share/icons/hicolor/256x256/apps/discord.png" ] && ok "Discord icon" || say "  note    no Discord icon (Discord's logo isn't shipped: put one at ~/.local/share/icons/hicolor/256x256/apps/discord.png)"
    fi
}

# ---------------------------------------------------------------- login screen
part_greeter() {
    say "login / lock screen"
    local src="$HOME/.config/rice-greeter" dst=/etc/greetd/rice-greeter f same=1
    [ -d "$dst" ] || { warn "greeter not installed: sudo $src/install.sh"; return; }
    # lock.qml is copied too but always runs from ~/.config (lock.sh): not compared
    for f in "$src"/*.qml; do [ "${f##*/}" = lock.qml ] || cmp -s "$f" "$dst/${f##*/}" || same=0; done
    [ "$same" = 1 ] && ok "installed copy is current" || warn "login screen is out of date: sudo $src/install.sh"
}


# ---------------------------------------------------------------- notifications, sounds, file picker
part_desktop() {
    say "notifications / sounds / file picker"
    if command -v noctalia >/dev/null; then
        local cfg; cfg=$(noctalia msg config-get notification 2>/dev/null)
        if printf '%s' "$cfg" | grep -q "border_width = 2" && printf '%s' "$cfg" | grep -q "border_color = 'on_surface_variant'" && printf '%s' "$cfg" | grep -q "background_opacity = 1"; then
            ok "notifications: solid 2px box"
        elif [ "$MODE" = apply ] && [ -n "$cfg" ]; then
            noctalia msg config-set notification.border_width 2 >/dev/null \
                && noctalia msg config-set notification.border_color "'on_surface_variant'" >/dev/null \
                && noctalia msg config-set notification.background_opacity 1 >/dev/null \
                && fixed "notifications: solid 2px box" || warn "could not set noctalia's notification style (did its settings change?)"
        else warn "notifications are not the rice's 2px box"; fi
    fi
    [ -f "$HOME/.local/share/sounds/rice/index.theme" ] && ok "sound theme" || {
        [ "$MODE" = apply ] && mkdir -p "$HOME/.local/share/sounds" && ln -sfn "$RICE/sounds/rice" "$HOME/.local/share/sounds/rice" && fixed "sound theme linked" || warn "sound theme not linked"; }
    gset org.gnome.desktop.sound theme-name rice
    # per-user folders noctalia needs (not in the shared config: they hold your home path)
    local k want cur
    for k in "shell.screenshot.directory|$HOME/Pictures/Screenshots" "wallpaper.directory|$HOME/Wallpapers"; do
        want=${k#*|}; k=${k%%|*}
        cur=$(noctalia msg config-get "$k" 2>/dev/null | tr -d "'\"")
        if [ "$cur" = "$want" ]; then ok "${k##*.}: ${want/#$HOME/\~}"
        elif [ "$MODE" = apply ] && command -v noctalia >/dev/null; then
            mkdir -p "$want"; noctalia msg config-set "$k" "'$want'" >/dev/null 2>&1 && fixed "${k##*.}: ${want/#$HOME/\~}" || warn "could not set noctalia's $k (is noctalia running?)"
        else warn "noctalia's $k is not $want"; fi
    done
    grep -q 'FileChooser=gtk' "$HOME/.config/xdg-desktop-portal/hyprland-portals.conf" 2>/dev/null && ok "one GTK file picker" || warn "file picker portal is not set to gtk"
    [ -x "$HOME/.local/bin/rice-slurp" ] && ok "screenshot selection colours" || link_to "$HOME/.local/bin/rice-slurp" "$RICE/bin/rice-slurp"
}

# ---------------------------------------------------------------- Firefox new tab, WhatsApp web app
newtab_wallpaper() {
    [ -e "$RICE/firefox/wallpaper.jpg" ] && [ -e "$(dirname "$(readlink -f "$RICE/firefox/newtab.html")")/wallpaper.jpg" ]
}
part_web() {
    say "firefox new tab / whatsapp"
    if [ -f /usr/lib/firefox/rice.cfg ]; then ok "new tab page (autoconfig)"
    else warn "new tab page not installed: sudo $RICE/system/install.sh"; fi
    if newtab_wallpaper; then ok "new tab wallpaper"
    elif [ "$MODE" = apply ]; then
        sh "$RICE/firefox/sync-wallpaper.sh"   # always exits 0 (it is also a noctalia hook): check the result
        newtab_wallpaper && fixed "new tab wallpaper" || warn "new tab wallpaper missing (needs noctalia running with a wallpaper set)"
    else warn "new tab wallpaper missing"; fi
    local p; p=$(ff_profile) || true
    if [ -n "$p" ] && jq -e '.addons[] | select(.id == "momentum@momentumdash.com" and .active)' "$p/extensions.json" >/dev/null 2>&1; then
        if [ "$MODE" = apply ] && ! running firefox; then
            ff_addons "$p" '(.addons[] | select(.id == "momentum@momentumdash.com")) |= (.active = false | .userDisabled = true)' \
                && fixed "Momentum turned off (it replaced the new tab page)" || warn "could not edit Firefox's add-on list ($p/extensions.json)"
        else warn "Momentum still replaces the new tab page; close Firefox and run: rice apply web"; fi
    else ok "nothing replaces the new tab page"; fi
    local wp="$HOME/.local/share/rice/whatsapp-profile"
    [ "$MODE" != apply ] || mkdir -p "$wp"
    link_to "$wp/chrome" "$RICE/whatsapp"
    link_to "$wp/user.js" "$RICE/whatsapp/user.js"
    grep -q "rice/whatsapp/whatsapp.sh" "$HOME/.local/share/applications/whatsapp-linux-desktop.desktop" 2>/dev/null \
        && ok "WhatsApp opens as the themed web app" || warn "WhatsApp launcher entry is not the web app"
}

# ---------------------------------------------------------------- terminal tools
part_terminal() {
    say "terminal tools"
    grep -q 'FZF_DEFAULT_OPTS' "$HOME/.config/fish/config.fish" 2>/dev/null && ok "fzf uses the terminal palette" || warn "fzf options missing from fish config"
    grep -q 'theme="ansi"' "$HOME/.config/bat/config" 2>/dev/null && ok "bat uses the terminal palette" || warn "bat theme is not ansi"
    grep -q '^color_theme = "TTY"' "$HOME/.config/btop/btop.conf" 2>/dev/null && ok "btop uses the terminal palette" || {
        [ "$MODE" = apply ] && sed -i --follow-symlinks -E 's/^color_theme = .*/color_theme = "TTY"/' "$HOME/.config/btop/btop.conf" && fixed "btop palette" || warn "btop theme is not TTY"; }
}

# ---------------------------------------------------------------- Qt (Kvantum), video, cursor
part_qt() {
    say "qt (kvantum)"
    command -v kvantummanager >/dev/null || [ -d /usr/share/Kvantum ] || { warn "kvantum is not installed"; return; }
    if [ -s "$HOME/.config/Kvantum/Rice/Rice.svg" ] && [ "$MODE" = check ]; then ok "Rice Kvantum theme"
    elif [ "$MODE" = apply ]; then python3 -I "$RICE/qt/make-kvantum.py" >/dev/null && fixed "Rice Kvantum theme rebuilt from the wallpaper" || warn "could not build the Kvantum theme"
    else warn "Rice Kvantum theme missing (rice apply qt)"; fi
    grep -q '^style=kvantum' "$HOME/.config/qt6ct/qt6ct.conf" && ok "qt6ct uses Kvantum" || {
        [ "$MODE" = apply ] && sed -i --follow-symlinks 's/^style=.*/style=kvantum/; s/^custom_palette=.*/custom_palette=false/' "$HOME/.config/qt6ct/qt6ct.conf" && fixed "qt6ct uses Kvantum" || warn "qt6ct style is not kvantum"; }
}
part_video() {
    say "video (mpv)"
    command -v mpv >/dev/null || { say "  skip    mpv is not installed"; return; }
    [ -s "$HOME/.config/mpv/script-opts/osc.conf" ] && ok "mpv controls themed" || warn "mpv osc.conf missing (rice apply colors)"
    [ "$(xdg-mime query default video/mp4)" = mpv.desktop ] && ok "mpv opens videos" || {
        [ "$MODE" = apply ] && for m in video/mp4 video/x-matroska video/webm video/quicktime video/x-msvideo video/mpeg video/ogg video/x-flv; do xdg-mime default mpv.desktop "$m"; done && fixed "mpv opens videos" || warn "videos do not open in mpv"; }
}
part_cursor() {
    say "cursor"
    gset org.gnome.desktop.interface cursor-theme phinger-cursors-light
    grep -q 'XCURSOR_THEME="phinger-cursors-light"' "$HOME/.config/uwsm/env" && ok "session cursor (uwsm env)" || warn "uwsm env cursor is not phinger-cursors-light"
}

# ---------------------------------------------------------------- idle, usb, updates
part_session() {
    say "idle / usb / updates"
    command -v hypridle >/dev/null && { pgrep -x hypridle >/dev/null && ok "hypridle running" || { [ "$MODE" = apply ] && (hyprctl dispatch "hl.dsp.exec_cmd(\"hypridle\")" >/dev/null) && fixed "hypridle started" || warn "hypridle is not running"; }; } || warn "hypridle is not installed (sudo pacman -S hypridle)"
    command -v udiskie >/dev/null && { pgrep -x udiskie >/dev/null && ok "udiskie running" || { [ "$MODE" = apply ] && (hyprctl dispatch "hl.dsp.exec_cmd(\"udiskie\")" >/dev/null) && fixed "udiskie started" || warn "udiskie is not running"; }; } || warn "udiskie is not installed (sudo pacman -S udiskie)"
    busctl --user status dev.rice.NotifyFocus >/dev/null 2>&1 && ok "notification clicks go to the app" || {
        [ "$MODE" = apply ] && (hyprctl dispatch "hl.dsp.exec_cmd(\"$RICE/bin/rice-notify-focus\")" >/dev/null) && fixed "rice-notify-focus started" || warn "rice-notify-focus is not running (notification clicks won't open the app)"; }
    command -v checkupdates >/dev/null && ok "update check (checkupdates)" || warn "checkupdates missing (pacman-contrib)"
    # only the rice lock screen: noctalia must not lock on its own before sleep
    if ! command -v noctalia >/dev/null; then :
    elif [ "$(noctalia msg config-get lockscreen.lock_before_suspend 2>/dev/null)" = "false" ]; then ok "only the rice lock before sleep"
    elif [ "$MODE" = apply ]; then noctalia msg config-set lockscreen.lock_before_suspend false >/dev/null 2>&1 && fixed "noctalia no longer locks before sleep" || warn "could not stop noctalia locking before sleep (is noctalia running?)"
    else warn "noctalia locks with its own screen before sleep (rice apply session)"; fi
}

# ---------------------------------------------------------------- dotfiles links
# Every file in ~/dotfiles is linked into your home folder. Some apps save by
# replacing the file (that breaks the link): their new version is copied into
# ~/dotfiles, then linked again, so nothing they changed is lost.
part_links() {
    local D n=0 line mode path dst via
    D=$(dots_dir)
    say "dotfiles (${D/#$HOME/\~}, linked into ~)"
    [ -d "$D/.git" ] || { warn "${D/#$HOME/\~} is missing (git clone https://github.com/AdiP1353/dotfiles ~/dotfiles)"; return; }
    while IFS= read -r -d '' line; do
        mode=${line%% *}; path=${line#*$'\t'}
        dst="$HOME/$path"
        if dots_skip "$path"; then
            # linked by older versions of install: not a config, take it out again
            if [ "$MODE" = apply ] && [ "$(readlink "$dst" 2>/dev/null)" = "$D/$path" ]; then
                rm -f "$dst"; rmdir "${dst%/*}" 2>/dev/null; fixed "unlinked ~/${path} (not a config)"
            fi
            continue
        fi
        [ "$mode" = 120000 ] && continue
        [ "$(readlink "$dst" 2>/dev/null)" = "$D/$path" ] && { n=$((n+1)); continue; }
        if via=$(dots_parent_link "$path"); then warn "${path} not linked: ${via/#$HOME/\~} is a link to somewhere else"; continue; fi
        if [ "$MODE" = apply ]; then
            if [ -f "$dst" ] && [ ! -L "$dst" ]; then cmp -s "$dst" "$D/$path" || cp "$dst" "$D/$path"; fi
            mkdir -p "$(dirname "$dst")"; ln -sfn "$D/$path" "$dst" && fixed "re-linked ${path} (kept the app's changes)"
        else warn "${path} is not linked into ${D/#$HOME/\~} (rice apply links)"; fi
    done < <(git -C "$D" ls-files -s -z)
    [ "$n" -gt 0 ] && ok "$n files linked"
}

ALL_PARTS=(links colors gtk qt cursor desktop firefox web obsidian spotify discord editor terminal video session launcher greeter)
run_parts() {
    local parts=("$@"); [ ${#parts[@]} -gt 0 ] || parts=("${ALL_PARTS[@]}")
    # Spotify first: noctalia's template hook also runs Spicetify, and two
    # Spicetify runs at once corrupt Spotify's files.
    local ordered=() p
    for p in spotify "${parts[@]}"; do
        [[ " ${parts[*]} " == *" $p "* ]] || continue
        [[ " ${ordered[*]:-} " == *" $p "* ]] || ordered+=("$p")
    done
    for p in "${ordered[@]}"; do
        if declare -F "part_$p" >/dev/null; then "part_$p"; else warn "unknown part: $p"; fi
    done
}

cmd_install() {
    MODE=apply
    say "installing the rice"
    mkdir -p "$HOME/.local/bin" "$HOME/.config/systemd/user"
    link_to "$HOME/.local/bin/rice" "$RICE/bin/rice"
    local u
    for u in rice-apply.service rice-apply.timer rice-spotify.service rice-spotify.path; do
        link_to "$HOME/.config/systemd/user/$u" "$RICE/systemd/$u"
    done
    # The timer used to be wanted by timers.target (from boot); now it follows
    # the desktop session. Drop the old hook-up by hand: `disable`/`reenable`
    # would also delete the unit links above (systemd treats them as "linked").
    rm -f "$HOME/.config/systemd/user/timers.target.wants/rice-apply.timer"
    rmdir "$HOME/.config/systemd/user/timers.target.wants" 2>/dev/null
    systemctl --user daemon-reload
    systemctl --user enable rice-apply.timer rice-spotify.path >/dev/null 2>&1 \
        && systemctl --user start rice-spotify.path >/dev/null 2>&1 \
        && { ! systemctl --user is-active --quiet graphical-session.target || systemctl --user start rice-apply.timer >/dev/null 2>&1; } \
        && ok "automatic re-apply on (login, every 6h, Spotify updates)" || warn "could not enable the systemd user units"
    run_parts
    say ""
    say "With sudo, once: re-apply after pacman updates, and the login screen:"
    say "  sudo $RICE/system/install.sh"
    say "  sudo $HOME/.config/rice-greeter/install.sh"
}

case "${1:-check}" in
    check)   shift || true; MODE=check; run_parts "$@" ;;
    apply)   shift; MODE=apply; [ "${1:-}" = "--quiet" ] && { QUIET=1; shift; }; run_parts "$@" ;;
    install) cmd_install ;;
    -h|--help|help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "usage: rice [check|apply [part...]|install]" >&2; exit 2 ;;
esac

[ "$QUIET" = 1 ] || { echo; [ "$BROKEN" = 0 ] && { [ "$FIXED" -gt 0 ] && echo "all good ($FIXED fixed)" || echo "all good"; } || echo "$BROKEN thing(s) need attention"; }
# Automatic runs (apply --quiet) log what needs attention but never "fail":
# those items wait on you (a sudo step, closing an app), not on the theme.
[ "$QUIET" = 1 ] || [ "$BROKEN" = 0 ]
