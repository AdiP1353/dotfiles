#!/bin/sh
# Runs from the bar's "upd N" (in a terminal): updates the system with
# cachy-update, CachyOS's updater. It lists what will change, shows the latest
# Arch / CachyOS news first, does the full upgrade (and AUR packages through
# paru, if installed), and helps with .pacnew files and reboots afterwards.
set -u
if ! command -v cachy-update >/dev/null; then
    echo "cachy-update isn't installed. install it with:"
    echo "    sudo pacman -S cachy-update"
    printf "press enter to close "; read -r _
    exit 1
fi
cachy-update
echo
printf "press enter to close "; read -r _
