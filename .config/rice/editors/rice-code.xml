<?xml version="1.0" encoding="UTF-8"?>
<!-- Code colours for GNOME Text Editor (THEME.md §5): fixed, never from the
     wallpaper, so code stays readable on any wallpaper. The same palette as
     the terminals (kitty/themes/rice-minimal.conf). -->
<style-scheme id="rice-code" name="Rice code" version="1.0">
  <author>rice</author>
  <description>The terminals' fixed minimal palette</description>
  <metadata>
    <property name="variant">dark</property>
    <property name="dark-variant">rice-code</property>
    <property name="light-variant">rice-code</property>
  </metadata>
  <color name="bg"     value="#111111"/>
  <color name="bg2"    value="#1c1c1c"/>
  <color name="sel"    value="#333333"/>
  <color name="fg"     value="#d0d0d0"/>
  <color name="dim"    value="#7a7a7a"/>
  <color name="line"   value="#555555"/>
  <color name="red"    value="#c97b7b"/>
  <color name="green"  value="#9fb98a"/>
  <color name="yellow" value="#cdb98a"/>
  <color name="blue"   value="#8ea6c4"/>
  <color name="purple" value="#b496c2"/>
  <color name="cyan"   value="#8fbcb6"/>

  <style name="text"                foreground="fg" background="bg"/>
  <style name="selection"           foreground="fg" background="sel"/>
  <style name="selection-unfocused" foreground="fg" background="bg2"/>
  <style name="cursor"              foreground="fg"/>
  <style name="current-line"        background="bg2"/>
  <style name="current-line-number" foreground="fg" background="bg2" bold="true"/>
  <style name="line-numbers"        foreground="line" background="bg"/>
  <style name="right-margin"        foreground="line" background="bg2"/>
  <style name="draw-spaces"         foreground="line"/>
  <style name="bracket-match"       foreground="fg" background="sel" bold="true"/>
  <style name="bracket-mismatch"    foreground="red" underline="red"/>
  <style name="search-match"        foreground="bg" background="yellow"/>
  <style name="map-overlay"         background="bg2"/>

  <style name="def:comment"         foreground="dim" italic="true"/>
  <style name="def:shebang"         foreground="dim" bold="true"/>
  <style name="def:keyword"         foreground="purple"/>
  <style name="def:statement"       foreground="purple"/>
  <style name="def:type"            foreground="yellow"/>
  <style name="def:function"        foreground="blue"/>
  <style name="def:identifier"      foreground="fg"/>
  <style name="def:constant"        foreground="cyan"/>
  <style name="def:number"          foreground="cyan"/>
  <style name="def:boolean"         foreground="cyan"/>
  <style name="def:special-constant" foreground="cyan"/>
  <style name="def:string"          foreground="green"/>
  <style name="def:special-char"    foreground="green" bold="true"/>
  <style name="def:preprocessor"    foreground="red"/>
  <style name="def:builtin"         foreground="yellow"/>
  <style name="def:operator"        foreground="fg"/>
  <style name="def:error"           foreground="red" underline="red"/>
  <style name="def:warning"         underline="yellow"/>
  <style name="def:note"            foreground="bg" background="yellow" bold="true"/>
  <style name="def:heading"         foreground="blue" bold="true"/>
  <style name="def:link-text"       foreground="blue"/>
  <style name="def:link-destination" foreground="dim" underline="single"/>
  <style name="def:inline-code"     foreground="green"/>
  <style name="def:insertion"       foreground="green"/>
  <style name="def:deletion"        foreground="red"/>
  <style name="def:emphasis"        italic="true"/>
  <style name="def:strong-emphasis" bold="true"/>
</style-scheme>
