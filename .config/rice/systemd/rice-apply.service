[Unit]
Description=Re-apply the rice theme wherever it is missing
# Only inside the desktop session: rice needs Hyprland, noctalia and the
# session bus. Started without one (the pacman hook from a TTY), it does nothing.
Requisite=graphical-session.target
After=graphical-session.target

[Service]
Type=oneshot
ExecStart=%h/.config/rice/bin/rice apply --quiet
