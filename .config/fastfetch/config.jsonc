// Terminal greeting (fish runs it on every new terminal; ~/.config/fish/config.fish),
// in the rice's minimal style (THEME.md §3): no icons, no boxes, no trees.
// Ly-style "label:" fields: lowercase labels in dim grey, values in light grey,
// two groups (system, then hardware) under user@host and a thin line.
// The picture on the left is ~/.config/fastfetch/logo.png (fish greeting).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "none" },
  "display": {
    "separator": "",
    "color": { "keys": "90", "separator": "90", "output": "37" },
    "percent": { "type": 1, "color": { "green": "37", "yellow": "33", "red": "31" } }
  },
  "modules": [
    { "type": "title", "format": "{#37}{user-name}{#90}@{#37}{host-name}" },
    { "type": "custom", "format": "{#90}────────────────────────────────────────" },
    { "type": "os",       "key": "os:      ",      "format": "{name} {arch}" },
    { "type": "kernel",   "key": "kernel:  ",  "format": "{release}" },
    { "type": "wm",       "key": "wm:      ",      "format": "{pretty-name} {version}" },
    { "type": "shell",    "key": "shell:   ",   "format": "{pretty-name} {version}" },
    { "type": "terminal", "key": "term:    ",    "format": "{pretty-name}" },
    { "type": "packages", "key": "pkgs:    " },
    "break",
    { "type": "cpu",      "key": "cpu:     ",     "format": "{name} ({cores-logical})" },
    { "type": "gpu",      "key": "gpu:     ",     "format": "{name}" },
    { "type": "memory",   "key": "mem:     ",     "format": "{used} / {total} ({percentage})" },
    { "type": "disk",     "key": "disk:    ",    "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "uptime",   "key": "up:      " }
  ]
}
