// Terminal greeting (fish runs this on every new terminal; see
// ~/.config/fish/config.fish). Two sections, "hardware" and "software",
// each opened by a titled line and closed by a plain one; every row is an
// icon, " :: ", and the value.
// Calm colours (THEME.md §3): icons in one soft teal from the Kitty palette,
// usage percentages in muted green, everything else plain grey.
// The art on the left is ~/.config/fastfetch/logo.txt. A logo.png in the same
// folder, if you ever add one, is shown instead (fish greeting).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Your ASCII art (logo.txt) in plain light grey, centred next to the specs.
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": { "1": "37" },
    "padding": { "top": 3, "left": 2, "right": 4 }
  },
  "display": {
    "separator": " :: ",
    "color": { "keys": "36", "separator": "90", "output": "37" },
    // usage percentages: one calm green whatever the value
    "percent": { "type": 1, "color": { "green": "32", "yellow": "32", "red": "32" } }
  },
  "modules": [
    { "type": "custom", "format": "{#90}┌────────────── {#37}hardware{#90} ──────────────┐" },
    { "type": "host",     "key": "", "format": "{name}" },
    { "type": "command",  "key": "", "text": "printf '%s (%sc/%st)' \"$(grep -m1 'model name' /proc/cpuinfo | sed -E 's/.*: //; s/.*(i[3579]-[0-9A-Z]+|Ryzen [0-9] [0-9A-Z]+).*/\\1/')\" \"$(lscpu -p=core | grep -v '^#' | sort -u | wc -l)\" \"$(nproc)\"" },
    { "type": "gpu",      "key": "", "format": "{name}" },
    { "type": "memory",   "key": "\udb80\udf5b", "format": "{used} / {total} ({#32}{percentage}{#})" },
    { "type": "disk",     "key": "", "folders": "/", "format": "{size-used} / {size-total} ({#32}{size-percentage}{#})" },
    { "type": "display",  "key": "", "format": "{name} ({width}x{height})" },
    "break",
    { "type": "custom", "format": "{#90}├────────────── {#37}software{#90} ──────────────┤" },
    { "type": "os",       "key": "", "format": "{name} {arch}" },
    { "type": "kernel",   "key": "", "format": "Linux {release}" },
    { "type": "wm",       "key": "", "format": "{pretty-name}" },
    { "type": "datetime", "key": "", "format": "{year}-{month-pretty}-{day-pretty} {hour-pretty}:{minute-pretty}:{second-pretty}" },
    { "type": "shell",    "key": "", "format": "{pretty-name} {version}" },
    { "type": "packages", "key": "" },
    "break",
    { "type": "custom", "format": "{#90}└──────────────────────────────────────┘" }
  ]
}
