<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by noctalia (rice_gtksourceview user template) from the
     wallpaper: GNOME Text Editor and other GtkSourceView 5 apps. -->
<style-scheme id="rice" name="Rice" version="1.0">
  <author>rice</author>
  <description>Wallpaper colours, minimal (THEME.md)</description>
  <metadata>
    <property name="variant">dark</property>
    <property name="dark-variant">rice</property>
    <property name="light-variant">rice</property>
  </metadata>

  <color name="bg"        value="{{colors.surface.default.hex}}"/>
  <color name="bg2"       value="{{colors.surface_container.default.hex}}"/>
  <color name="fg"        value="{{colors.on_surface.default.hex}}"/>
  <color name="dim"       value="{{colors.on_surface_variant.default.hex}}"/>
  <color name="outline"   value="{{colors.outline_variant.default.hex}}"/>
  <color name="primary"   value="{{colors.primary.default.hex}}"/>
  <color name="secondary" value="{{colors.secondary.default.hex}}"/>
  <color name="tertiary"  value="{{colors.tertiary.default.hex}}"/>
  <color name="error"     value="{{colors.error.default.hex}}"/>
  <color name="on_primary" value="{{colors.on_primary.default.hex}}"/>

  <!-- the editor itself -->
  <style name="text"                  foreground="fg" background="bg"/>
  <style name="selection"             foreground="fg" background="outline"/>
  <style name="selection-unfocused"   foreground="fg" background="bg2"/>
  <style name="cursor"                foreground="fg"/>
  <style name="secondary-cursor"      foreground="dim"/>
  <style name="current-line"          background="bg2"/>
  <style name="current-line-number"   foreground="fg" background="bg2" bold="true"/>
  <style name="line-numbers"          foreground="outline" background="bg"/>
  <style name="right-margin"          foreground="outline" background="bg2"/>
  <style name="draw-spaces"           foreground="outline"/>
  <style name="background-pattern"    background="bg2"/>
  <style name="bracket-match"         foreground="fg" background="outline" bold="true"/>
  <style name="bracket-mismatch"      foreground="error" underline="error"/>
  <style name="search-match"          foreground="on_primary" background="primary"/>
  <style name="map-overlay"           background="bg2"/>

  <!-- code: comments dim, the palette's three tones for the rest -->
  <style name="def:comment"           foreground="dim" italic="true"/>
  <style name="def:shebang"           foreground="dim" bold="true"/>
  <style name="def:doc-comment-element" foreground="dim" bold="true"/>
  <style name="def:keyword"           foreground="primary" bold="true"/>
  <style name="def:statement"         foreground="primary"/>
  <style name="def:type"              foreground="tertiary"/>
  <style name="def:function"          foreground="primary"/>
  <style name="def:identifier"        foreground="fg"/>
  <style name="def:constant"          foreground="tertiary"/>
  <style name="def:number"            foreground="tertiary"/>
  <style name="def:boolean"           foreground="tertiary"/>
  <style name="def:special-constant"  foreground="tertiary"/>
  <style name="def:string"            foreground="secondary"/>
  <style name="def:special-char"      foreground="secondary" bold="true"/>
  <style name="def:preprocessor"      foreground="secondary"/>
  <style name="def:builtin"           foreground="tertiary"/>
  <style name="def:operator"          foreground="dim"/>
  <style name="def:error"             foreground="error" underline="error"/>
  <style name="def:warning"           underline="tertiary"/>
  <style name="def:note"              foreground="bg" background="tertiary" bold="true"/>
  <style name="def:underlined"        underline="single"/>
  <style name="def:emphasis"          italic="true"/>
  <style name="def:strong-emphasis"   bold="true"/>
  <style name="def:heading"           foreground="primary" bold="true"/>
  <style name="def:link-text"         foreground="primary"/>
  <style name="def:link-destination"  foreground="dim" underline="single"/>
  <style name="def:inline-code"       foreground="secondary"/>
  <style name="def:insertion"         foreground="secondary"/>
  <style name="def:deletion"          foreground="error"/>
</style-scheme>
